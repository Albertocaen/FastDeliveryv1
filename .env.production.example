# =========================================================================
# PLANTILLA .env PARA DESPLIEGUE EN ORACLE CLOUD (VM Always Free - Ampere A1)
# Dominio de produccion: bacodelivery.com
# =========================================================================
# 1. Copia este archivo como .env en la VM:   cp .env.production.example .env
# 2. Sustituye TODAS las variables marcadas con "CAMBIA_..." por valores reales.
# 3. NO subas este archivo .env al repositorio (ya esta en .gitignore).
# =========================================================================

# ---------- Puerto interno del contenedor Spring ----------
SERVER_PORT=8080

# ---------- Direcciones publicas ----------
APP_BASE_URL=https://bacodelivery.com
API_BASE_URL=https://bacodelivery.com

# ---------- Caddy ----------
# Caddy emitira certificado Let's Encrypt automaticamente para este dominio.
# Requiere que el DNS apunte a la IP de la VM y que los puertos 80/443 esten abiertos.
CADDY_SITE_ADDRESS=bacodelivery.com

# ---------- Base de datos (interna Docker Compose, NO se publica al host) ----------
SPRING_DATASOURCE_URL=jdbc:mysql://usuario-mysql:3306/FastDelivery
SPRING_DATASOURCE_USERNAME=caen
SPRING_DATASOURCE_PASSWORD=CAMBIA_ESTA_PASSWORD_DB
SPRING_JPA_HIBERNATE_DDL_AUTO=none
SPRING_JPA_SHOW_SQL=false
SPRING_THYMELEAF_CACHE=true

# ---------- MySQL interno ----------
MYSQL_ROOT_PASSWORD=CAMBIA_ESTA_PASSWORD_ROOT
MYSQL_DATABASE=FastDelivery
MYSQL_USER=caen
MYSQL_PASSWORD=CAMBIA_ESTA_PASSWORD_DB

# ---------- JWT (minimo 64 caracteres, aleatorio) ----------
# Generar:  openssl rand -base64 64 | tr -d '\n/+='
JWT_SECRET=CAMBIA_ESTE_SECRETO_POR_UNO_DE_AL_MENOS_64_CARACTERES_SEGURO_Y_UNICO_AAAA
JWT_EXPIRATION=3600

# ---------- Uploads dentro del contenedor ----------
RUTA_IMAGENES=/app/uploads
UPLOADS_PATH=/app/uploads

# ---------- Correo (SMTP) ----------
# Para Gmail usa una "contrasena de aplicacion" (no la contrasena real).
SPRING_MAIL_HOST=smtp-mail.outlook.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=tu-correo@example.com
SPRING_MAIL_PASSWORD=CAMBIA_TU_APP_PASSWORD
SPRING_MAIL_SMTP_AUTH=true
SPRING_MAIL_STARTTLS_ENABLE=true
SPRING_MAIL_DEBUG=false

# ---------- PayPal ----------
# Con HTTPS y dominio real, PayPal live ya puede usarse. Arranca en sandbox y
# cambia a 'live' solo cuando hayas validado el flujo completo.
PAYPAL_CLIENT_ID=CAMBIA_TU_PAYPAL_CLIENT_ID
PAYPAL_CLIENT_SECRET=CAMBIA_TU_PAYPAL_SECRET
PAYPAL_MODE=sandbox
PAYPAL_SUCCESS_URL=https://bacodelivery.com/pedidos/success
PAYPAL_CANCEL_URL=https://bacodelivery.com/pedidos/cancel

# ---------- Logging y JVM ----------
# Para Ampere A1 con 6GB de RAM, deja estos valores o sube Xmx a 768m si sobra RAM.
LOGGING_LEVEL_ROOT=INFO
JAVA_OPTS=-Xms256m -Xmx512m -XX:+UseG1GC -XX:MaxRAMPercentage=75.0

# ---------- DevTools (siempre desactivados en produccion) ----------
SPRING_DEVTOOLS_RESTART_ENABLED=false
SPRING_DEVTOOLS_LIVERELOAD_ENABLED=false
