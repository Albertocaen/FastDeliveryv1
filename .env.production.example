# Copia este archivo como .env en el servidor remoto.
# Sustituye tu-dominio.com por tu dominio real o por http://IP_DEL_SERVIDOR:8080 si aun no tienes dominio.

# URL publica de la aplicacion
SERVER_PORT=8080
APP_BASE_URL=https://tu-dominio.com
API_BASE_URL=https://tu-dominio.com
CADDY_SITE_ADDRESS=tu-dominio.com

# Base de datos interna de Docker Compose
SPRING_DATASOURCE_URL=jdbc:mysql://usuario-mysql:3306/FastDelivery
SPRING_DATASOURCE_USERNAME=caen
SPRING_DATASOURCE_PASSWORD=cambia-esta-password
SPRING_JPA_HIBERNATE_DDL_AUTO=none
SPRING_JPA_SHOW_SQL=false

# MySQL interno. No se publica fuera del servidor.
MYSQL_ROOT_PASSWORD=cambia-esta-password-root
MYSQL_DATABASE=FastDelivery
MYSQL_USER=caen
MYSQL_PASSWORD=cambia-esta-password

# JWT
JWT_SECRET=cambia-este-secreto-por-uno-de-al-menos-64-caracteres-seguro-y-unico
JWT_EXPIRATION=3600

# Uploads dentro del contenedor
RUTA_IMAGENES=/app/uploads
UPLOADS_PATH=/app/uploads

# Correo
SPRING_MAIL_HOST=smtp-mail.outlook.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=tu-correo@example.com
SPRING_MAIL_PASSWORD=tu-password-o-app-password
SPRING_MAIL_SMTP_AUTH=true
SPRING_MAIL_STARTTLS_ENABLE=true
SPRING_MAIL_DEBUG=false

# PayPal
PAYPAL_CLIENT_ID=tu-paypal-client-id
PAYPAL_CLIENT_SECRET=tu-paypal-client-secret
PAYPAL_MODE=sandbox
PAYPAL_SUCCESS_URL=https://tu-dominio.com/pedidos/success
PAYPAL_CANCEL_URL=https://tu-dominio.com/pedidos/cancel

# JVM
LOGGING_LEVEL_ROOT=INFO
JAVA_OPTS=-Xms256m -Xmx512m
